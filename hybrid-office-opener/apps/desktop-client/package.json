{
  "name": "officex",
  "version": "1.2.0",
  "description": "Desktop launcher for OfficeX - Open Office files with Google Docs/Sheets",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg src/index.js --targets node18-win-x64 --output dist/OfficeX.exe --public --compress GZip",
    "build:mac": "pkg src/index.js --targets node18-macos-x64 --output dist/OfficeX --public --compress GZip",
    "build:mac-arm": "pkg src/index.js --targets node18-macos-arm64 --output dist/OfficeX --public --compress GZip",
    "build:linux": "pkg src/index.js --targets node18-linux-x64 --output dist/OfficeX --public --compress GZip",
    "build:all": "pkg src/index.js --targets node18-win-x64,node18-macos-x64,node18-macos-arm64,node18-linux-x64 --output dist/OfficeX --public --compress GZip"
  },
  "pkg": {
    "assets": [
      "config.json",
      "extension-key.pem",
      "src/assets/**/*",
      "rcedit.exe",
      "../browser-extension/**/*"
    ]
  },
  "author": "OfficeX Team",
  "license": "ISC"
}
